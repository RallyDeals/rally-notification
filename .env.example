# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real secrets.

# Notification service port (default: 8010)
SERVER_PORT=8010

# ---- Mail / Mailpit (defaults: localhost:1080, no auth) -------------
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1080
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false
MAIL_FROM=no-reply@rally.local

# OTP decryption (must match rally-auth's app.otp.encryption.*)
OTP_ENCRYPTION_PASSWORD=Rally@OtpKey2026!Sec
OTP_ENCRYPTION_SALT=41b0bf0fbeeb24a5022dc25ead1b5009

# ---- optional / infra ---------------------------------------------
# OTel OTLP exporter endpoint (empty = no remote collector, local default is used)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Logging level for business code (com.rally.notification), default INFO
LOGGING_LEVEL_RALLY=INFO